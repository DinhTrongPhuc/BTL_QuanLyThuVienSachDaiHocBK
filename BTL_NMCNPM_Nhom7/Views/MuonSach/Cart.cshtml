@model List<YourProject.ViewModels.CartItem>

@{
    ViewData["Title"] = "Giỏ mượn sách";
    Layout = "_GuestLayout";
}

<h1>@ViewData["Title"]</h1>

@if (Model.Any())
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th style="width: 120px;">Số lượng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenSach</td>
                    <td>@item.TacGia</td>
                    <td>
                       @item.SoLuong
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <form asp-controller="MuonSach" asp-action="ConfirmBorrow" method="post">
            <button type="submit" class="btn btn-primary">Xác nhận mượn tất cả</button>
            <a asp-controller="MuonSach" asp-action="Index" class="btn btn-secondary">Quay lại chọn sách</a>
        </form>
    </div>
}
else
{
    <div class="alert alert-info mt-4">
        <p>Giỏ mượn của bạn đang trống.</p>
    </div>
}
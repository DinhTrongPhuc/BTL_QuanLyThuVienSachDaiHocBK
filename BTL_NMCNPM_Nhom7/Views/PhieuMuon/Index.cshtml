@model IEnumerable<YourProject.Models.PhieuMuon>

@{
    ViewData["Title"] = "Quản lý Mượn trả";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-bordered table-striped mt-3">
    <thead class="table-light">
        <tr>
            <th>
                ID Phiếu
            </th>
            <th>
                Tên độc giả
            </th>
            <th>
                Ngày mượn
            </th>
            <th>
                Ngày hẹn trả
            </th>
            <th>
                Trạng thái
            </th>
            <th style="width: 120px;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.MaPhieuMuon
                </td>
                <td>
                    @item.DocGia?.HoTen
                </td>
                <td>
                    @item.NgayMuon.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.NgayHenTra.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @if (item.TrangThai == "Đang mượn")
                    {
                        <span class="badge bg-success">@item.TrangThai</span>
                    }
                    else if (item.TrangThai == "Quá hạn")
                    {
                        <span class="badge bg-danger">@item.TrangThai</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.TrangThai</span>
                    }
                </td>
                <td>
                    <div> @if (item.TrangThai == "Chờ duyệt")
                    {
                        <form asp-action="Duyet" asp-route-id="@item.MaPhieuMuon" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-sm">Duyệt</button>
                        </form>
                        <form asp-action="TuChoi" asp-route-id="@item.MaPhieuMuon" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Từ chối</button>
                        </form>
                    }
                    @if (item.TrangThai == "Chờ trả sách")
                        {
                            <form asp-action="XacNhanTra" asp-route-id="@item.MaPhieuMuon" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Xác nhận đã trả</button>
                            </form>
                            <form asp-action="TuChoiTra" asp-route-id="@item.MaPhieuMuon" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning btn-sm">Từ chối</button>
                            </form>
                        }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@item.MaPhieuMuon" class="btn btn-info btn-sm">Xem chi tiết</a>
                    }</div>
                </td>
            </tr>
        }
    </tbody>
</table>